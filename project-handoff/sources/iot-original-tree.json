      },
      {
        "id": "CO3",
        "text": "Describe various IoT protocols for communication between different endpoints to develop client server application.",
        "bloom_level": "L2_UNDERSTAND"
      },
      {
        "id": "CO4",
        "text": "Explain various elements of IoT Securities",
        "bloom_level": "L2_UNDERSTAND"
      },
      {
        "id": "CO5",
        "text": "Make use of various cloud offering available for IoT Platform",
        "bloom_level": "L3_APPLY"
      }
    ]
  },
