# Copy to .env and replace every example value before starting the shared-mode container.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-at-least-12-characters
WORKSPACE_PORT=8000
COOKIE_SECURE=0
# On Linux with loopback-only host Ollama, use docker-compose.loopback-ollama.yml.
MODEL_URL=http://host.docker.internal:11434
JUDGE_MODEL_NAME=gemma4:12b
HELPER_MODEL_NAME=gemma4:12b
EMBEDDING_MODEL_NAME=qwen3-embedding:4b
MODEL_THINKING=auto
MODEL_MAX_OUTPUT_TOKENS=2048
CHAT_CONTEXT_TOKENS=8192
COMPARISON_CONTEXT_TOKENS=8192
EXPORT_RETENTION_DAYS=30
OCR_MODEL_NAME=hf.co/PaddlePaddle/PaddleOCR-VL-1.6-GGUF
